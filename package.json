{
  "name": "opendta-pyodide",
  "version": "0.2.3",
  "description": "Run Stata 14 commands, graphs and Mata in the browser or Node on Pyodide, using OpenDTA's open-source engine.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./opendta.json": "./opendta.json",
    "./opendta_bridge.py": "./opendta_bridge.py"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "opendta.json",
    "opendta_bridge.py",
    "scripts/",
    "LICENSE",
    "LICENSE-OpenDTA"
  ],
  "scripts": {
    "test": "node --experimental-wasm-jspi --test --test-concurrency=1 test/*.test.mjs"
  },
  "peerDependencies": {
    "pyodide": ">=0.27.0 <0.28.0"
  },
  "devDependencies": {
    "pyodide": "0.27.7"
  },
  "keywords": [
    "stata",
    "mata",
    "do-file",
    "pyodide",
    "webassembly",
    "statistics",
    "econometrics",
    "opendta"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakliTechie/opendta-pyodide.git"
  },
  "homepage": "https://github.com/NakliTechie/opendta-pyodide#readme",
  "engines": {
    "node": ">=22"
  }
}
